    "program": "program spike_up.aleo;\n\nmapping slots:\n    key as u32.public;\n    value as u32.public;\n\nfunction put:\n    input r0 as u32.public;\n    input r1 as u32.public;\n    async put r0 r1 into r2;\n    output r2 as spike_up.aleo/put.future;\n\nfinalize put:\n    input r0 as u32.public;\n    input r1 as u32.public;\n    set r1 into slots[r0];\n\nfunction clear:\n    input r0 as u32.public;\n    async clear r0 into r1;\n    output r1 as spike_up.aleo/clear.future;\n\nfinalize clear:\n    input r0 as u32.public;\n    set 0u32 into slots[r0];\n\nfunction probe:\n    input r0 as u32.public;\n    async probe r0 into r1;\n    output r1 as spike_up.aleo/probe.future;\n\nfinalize probe:\n    input r0 as u32.public;\n    set 7u32 into slots[r0];\n\nfunction touch:\n    input r0 as u32.public;\n    async touch r0 into r1;\n    output r1 as spike_up.aleo/touch.future;\n\nfinalize touch:\n    input r0 as u32.public;\n    set 9u32 into slots[r0];\n\nconstructor:\n    assert.eq program_owner aleo1rhgdu77hgyqd3xjj8ucu3jj9r2krwz6mnzyd80gncr5fxcwlh5rsvzp9px;\n",
